<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless tests of the river generator (Game/Core has no Godot dependency).
       Run: dotnet run (project Tests/Core.Tests, Release), optional args: map out.png -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>12</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Game/Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
